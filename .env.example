# Copy this file to .env.local (not .en.local). Restart Next.js after changes.
# Public URL must match the exact browser origin; use HTTPS for deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only PostgreSQL connection for administration/migrations.
# Supabase > Connect > Direct connection (or Session pooler for IPv4 networks).
# Use your database password, URL-encoded, and SSL; never expose this to the browser.
DATABASE_URL=
# Optional absolute/relative path to the CA certificate downloaded from Supabase.
# Defaults to supabase-ca.crt in the project root. Certificate verification stays enabled.
DATABASE_CA_CERT_PATH=supabase-ca.crt
# Keep verify for Supabase/local-to-hosted/live connections.
# disable is accepted only for a PostgreSQL server on localhost/127.0.0.1/::1.
DATABASE_SSL_MODE=verify
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable: changing this invalidates pending sign-ins and encrypted integration tokens.
AUTH_ENCRYPTION_KEY=
# Independent server-only secret (at least 32 characters) for the invoice delivery scheduler.
INVOICE_CRON_SECRET=
# Optional public HTTPS origin for invoice/payment emails when CRM runs locally.
# Must serve the current CRM build and invoice-status/API routes, not just a website.
# INR Pay Now uses the saved Razorpay link directly; USD needs deployed checkout routes.
INVOICE_PUBLIC_URL=

# Provider variables below are optional legacy/bootstrap defaults.
# Admin/Super Admin can save credentials in CRM > Integrations after migrations.
# A saved CRM provider configuration replaces that provider's environment values.
# GOOGLE_REDIRECT_URI is an environment-specific override even when Gmail is saved in CRM.
# Keep Supabase, AUTH_ENCRYPTION_KEY and NEXT_PUBLIC_APP_URL server configured.

# SMTP bootstrap is needed for the first login; later manage it in CRM.
# Use a public hostname: 465/true for TLS, 587/false or 2525/false for STARTTLS.
# STARTTLS is required on all non-implicit-TLS connections.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Zoom Server-to-Server OAuth, needed only for Zoom-hosted meetings.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me
ZOOM_USE_CRM_HOST_EMAIL=false
ZOOM_WEBHOOK_SECRET_TOKEN=
CRM_TIMEZONE=Asia/Kolkata

# Razorpay QR API access and a separate webhook signing secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# USD invoices use Stripe Checkout; subscribe the deployed webhook to
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth / Gmail integration (register the callback URL in Google Cloud).
# Register both local and live callback URLs on the same Google OAuth client.
# On the live server, set this URI to its HTTPS origin + /api/auth/gmail/callback.
GOOGLE_MAILBOX_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
# Alternative: choose workspace in CRM > Integrations for administrator-managed Gmail.
# Set the Workspace domain and paste a service account JSON key in CRM (encrypted).
# A Workspace super administrator must authorize its client_id for both Gmail scopes.
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Facebook Lead Ads. Configure a Page token with approved lead retrieval access.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# PAGE_ID/PAGE_ACCESS_TOKEN are legacy single-Page defaults.
# Manage multiple encrypted Page tokens and form routes in CRM > Integrations.
# A supported Graph version selected for your Meta application.
FACEBOOK_GRAPH_VERSION=

# Website/chatbot intake, server-to-server only.
# Generate an independent random secret; share only with your trusted intake backend.
LEAD_INTAKE_SIGNING_KEY=
# Create per-source API keys, assignment and stage in the Integrations screen.
# Source API keys are displayed once. Never expose either key in browser JavaScript.
